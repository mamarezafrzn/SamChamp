{
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "^react$",
    "^next(/.*)?$",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/app/",
    "",
    "^@/components/",
    "",
    "^@/store",
    "",
    "^@/(lib|types|utils)/",
    "",
    "^[./]",
    "",
    "^@/public/"
  ],
  "tailwindFunctions": ["cn"]
}
