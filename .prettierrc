{
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react$",
    "^next(/.*)?$",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/app/",
    "",
    "^@/components/",
    "",
    "^@/store",
    "",
    "^@/(lib|types|utils)/",
    "",
    "^[./]",
    "",
    "^@/public/"
  ]
}
